PORT=5000
NODE_ENV=development

# PostgreSQL Connection Configuration
# Replace "your_postgres_password" with your local PostgreSQL password
DATABASE_URL=postgres://postgres:your_postgres_password@localhost:5432/gomodeals
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGHOST=localhost
PGPORT=5432
PGDATABASE=gomodeals

# JWT & Authentication Secret
JWT_SECRET=gomodeals_super_secret_jwt_key_2026_secured

# Client URL for CORS
CLIENT_URL=http://localhost:5174
FRONTEND_URL=http://localhost:5174
